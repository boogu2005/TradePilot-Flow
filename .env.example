# Copy to .env and fill values locally. Never commit the filled file.
# Start with OKX testnet and a separate set of test credentials.
OKX_MODE=testnet
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_TARGET_GROUPS=
TG_WHITELIST_SENDERS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

DATABASE_URL=sqlite:///user_data/trading_bot.db
DASHBOARD_DATABASE_URL=sqlite:///user_data/dashboard.db
DASHBOARD_LIVE_OKX=0
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_SECRET=

# Optional proxy and local gateway
EXCHANGE_PROXY=
TRADING_GATEWAY_HOST=127.0.0.1
TRADING_GATEWAY_PORT=9802

# Optional unresolved-incident investigator. It never bypasses trading rules.
DIAGNOSTIC_AGENT_ENABLED=0
DIAGNOSTIC_EXECUTION_ENABLED=1
DIAGNOSTIC_AGENT_MODEL=
DIAGNOSTIC_MAX_STEPS=7
DIAGNOSTIC_MAX_SECONDS=60
DIAGNOSTIC_MAX_TOOL_CALLS=10
DIAGNOSTIC_MAX_TOKENS=8000
DIAGNOSTIC_MAX_NO_PROGRESS=3
DIAGNOSTIC_LOG_PATH=user_data/logs/systemd.log
